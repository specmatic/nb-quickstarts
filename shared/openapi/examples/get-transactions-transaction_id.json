{
  "http-request": {
    "method": "GET",
    "path": "/transactions/1"
  },
  "http-response": {
    "status": 200,
    "body": {
      "id": 1,
      "name": "$match(exact: Cash)",
      "quantity": "$match(exact: 100000)",
      "source": "$match(exact: seed)",
      "createdAt": "2024-01-01T00:00:00Z"
    }
  }
}
