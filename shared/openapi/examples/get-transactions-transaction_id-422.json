{
  "http-request": {
    "method": "GET",
    "path": "/transactions/not-a-number"
  },
  "http-response": {
    "status": 422,
    "body": {
      "detail": "$match(exact: $(data.validationErrors))"
    }
  },
  "data": {
    "validationErrors": [
      {
        "type": "int_parsing",
        "loc": [
          "path",
          "transaction_id"
        ],
        "msg": "Input should be a valid integer, unable to parse string as an integer",
        "input": "not-a-number"
      }
    ]
  }
}
