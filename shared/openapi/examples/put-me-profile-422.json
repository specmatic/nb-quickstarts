{
  "before": [
    {
      "type": "http",
      "http-request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "username": "${SPECMATIC_USERNAME:\"\"}",
          "password": "${SPECMATIC_PASSWORD:\"\"}"
        },
        "baseUrl": "http://backend:8080"
      },
      "http-response": {
        "status": 200,
        "body": {
          "token": "(ACCESS_TOKEN:string)",
          "username": "${SPECMATIC_USERNAME:\"\"}"
        }
      }
    }
  ],
  "http-request": {
    "method": "PUT",
    "path": "/me/profile",
    "headers": {
      "Authorization": "Bearer ${ACCESS_TOKEN:$(ACCESS_TOKEN)}"
    },
    "body": {
      "language": "fr"
    }
  },
  "http-response": {
    "status": 422,
    "body": {
      "detail": "$match(exact: $(data.validationErrors))"
    }
  },
  "data": {
    "validationErrors": [
      {
        "type": "literal_error",
        "loc": [
          "body",
          "language"
        ],
        "msg": "Input should be 'ja' or 'en'",
        "input": "fr",
        "ctx": {
          "expected": "'ja' or 'en'"
        }
      }
    ]
  }
}
