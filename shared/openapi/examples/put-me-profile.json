{
  "before": [
    {
      "type": "http",
      "http-request": {
        "method": "POST",
        "path": "/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "username": "${SPECMATIC_USERNAME:\"\"}",
          "password": "${SPECMATIC_PASSWORD:\"\"}"
        },
        "baseUrl": "http://backend:8080"
      },
      "http-response": {
        "status": 200,
        "body": {
          "token": "(ACCESS_TOKEN:string)",
          "username": "${SPECMATIC_USERNAME:\"\"}"
        }
      }
    }
  ],
  "http-request": {
    "method": "PUT",
    "path": "/me/profile",
    "headers": {
      "Authorization": "Bearer ${ACCESS_TOKEN:$(ACCESS_TOKEN)}"
    },
    "body": {
      "displayName": "Demo User",
      "language": "ja"
    }
  },
  "http-response": {
    "status": 200,
    "body": {
      "username": "$match(exact: ${SPECMATIC_USERNAME:\"\"})",
      "email": "$match(exact: demo@nasebanal.com)",
      "displayName": "$match(exact: Demo User)",
      "language": "$match(exact: ja)",
      "provider": "$match(exact: demo)"
    }
  }
}
